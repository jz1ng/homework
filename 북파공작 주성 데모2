class Bullet:
    """플레이어가 발사하는 총알 클래스"""

    def __init__(self, x, y, dx, dy, weapon):
        self.x = x
        self.y = y
        self.dx = dx
        self.dy = dy
        self.weapon = weapon
        self.radius = weapon["bullet_radius"]
        self.speed = weapon["bullet_speed"]
        self.damage = weapon["damage"]

    def update(self):
        self.x += self.dx * self.speed
        self.y += self.dy * self.speed

    def offscreen(self):
        return self.x < -20 or self.x > WIDTH + 20 or self.y < -20 or self.y > HEIGHT + 20

    def draw(self, surface):
        pygame.draw.circle(surface, self.weapon["color"], (int(self.x), int(self.y)), self.radius)


class BossBullet:
    """보스가 플레이어에게 발사하는 원거리 공격 총알"""

    def __init__(self, x, y, dx, dy, speed=7, damage=8, radius=8):
        self.x = x
        self.y = y
        self.dx = dx
        self.dy = dy
        self.speed = speed
        self.damage = damage
        self.radius = radius

    def update(self):
        self.x += self.dx * self.speed
        self.y += self.dy * self.speed

    def offscreen(self):
        return self.x < -20 or self.x > WIDTH + 20 or self.y < -20 or self.y > HEIGHT + 20

    def draw(self, surface):
        pygame.draw.circle(surface, PURPLE, (int(self.x), int(self.y)), self.radius)


class Player:
    """플레이어(캐릭터) 클래스"""

    def __init__(self):
        self.x = WIDTH // 2
        self.y = HEIGHT // 2
        self.radius = 20
        self.speed = 5
        self.hp = 100
        self.max_hp = 100
        self.weapon_key = "pistol"
        self.cooldown = 0

    def move(self, keys):
        dx, dy = 0, 0
        if keys[pygame.K_w] or keys[pygame.K_UP]:
            dy -= 1
        if keys[pygame.K_s] or keys[pygame.K_DOWN]:
            dy += 1
        if keys[pygame.K_a] or keys[pygame.K_LEFT]:
            dx -= 1
        if keys[pygame.K_d] or keys[pygame.K_RIGHT]:
            dx += 1

        if dx != 0 or dy != 0:
            length = math.hypot(dx, dy)
            dx, dy = dx / length, dy / length
            self.x += dx * self.speed
            self.y += dy * self.speed

        self.x = max(self.radius, min(WIDTH - self.radius, self.x))
        self.y = max(self.radius, min(HEIGHT - self.radius, self.y))

    def update(self):
        if self.cooldown > 0:
            self.cooldown -= 1

    def try_shoot(self, target_x, target_y, bullets):
        if self.cooldown == 0:
            weapon = WEAPONS[self.weapon_key]
            self.cooldown = weapon["cooldown"]
            dx, dy = target_x - self.x, target_y - self.y
            dist = math.hypot(dx, dy)
            if dist == 0:
                dx, dy = 1, 0
            else:
                dx, dy = dx / dist, dy / dist
            bullets.append(Bullet(self.x, self.y, dx, dy, weapon))

    def draw(self, surface, mouse_pos):
        pygame.draw.circle(surface, BLUE, (int(self.x), int(self.y)), self.radius)

        dx, dy = mouse_pos[0] - self.x, mouse_pos[1] - self.y
        dist = math.hypot(dx, dy)
        if dist > 0:
            dx, dy = dx / dist, dy / dist
            end_x, end_y = self.x + dx * 30, self.y + dy * 30
            pygame.draw.line(surface, WHITE, (self.x, self.y), (end_x, end_y), 2)

        bar_w = 200
        pygame.draw.rect(surface, GRAY, (10, 10, bar_w, 20))
        pygame.draw.rect(surface, RED, (10, 10, bar_w * (self.hp / self.max_hp), 20))
        hp_text = font.render(f"HP: {self.hp}/{self.max_hp}", True, WHITE)
        surface.blit(hp_text, (15, 12))

        weapon = WEAPONS[self.weapon_key]
        w_text = font.render(f"무기: {weapon['name']}", True, weapon["color"])
        surface.blit(w_text, (10, 40))


class Monster:
    """적(몬스터) 클래스"""

    def __init__(self, hp_bonus=0):
        side = random.choice(["top", "bottom", "left", "right"])
        if side == "top":
            self.x, self.y = random.randint(0, WIDTH), -20
        elif side == "bottom":
            self.x, self.y = random.randint(0, WIDTH), HEIGHT + 20
        elif side == "left":
            self.x, self.y = -20, random.randint(0, HEIGHT)
        else:
            self.x, self.y = WIDTH + 20, random.randint(0, HEIGHT)

        self.radius = 16
        self.speed = 1.8
        self.max_hp = 50 + hp_bonus
        self.hp = self.max_hp
        self.damage = 5
        self.hit_cooldown = 0

    def update(self, player):
        dx, dy = player.x - self.x, player.y - self.y
        dist = math.hypot(dx, dy)
        if dist > 1:
            dx, dy = dx / dist, dy / dist
            self.x += dx * self.speed
            self.y += dy * self.speed

        if self.hit_cooldown > 0:
            self.hit_cooldown -= 1

        if dist < self.radius + player.radius and self.hit_cooldown == 0:
            player.hp -= self.damage
            self.hit_cooldown = 30

    def draw(self, surface):
        pygame.draw.circle(surface, RED, (int(self.x), int(self.y)), self.radius)
        bar_w = 30
        pygame.draw.rect(surface, GRAY, (self.x - bar_w / 2, self.y - self.radius - 10, bar_w, 5))
        pygame.draw.rect(surface, (0, 200, 0),
                         (self.x - bar_w / 2, self.y - self.radius - 10, bar_w * (self.hp / self.max_hp), 5))


class Boss:
    """보스 클래스 - 몬스터보다 훨씬 강하고, 근접 + 원거리 공격을 모두 사용"""

    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.radius = 45
        self.speed = 2.2
        self.max_hp = 1200
        self.hp = self.max_hp
        self.contact_damage = 12
        self.hit_cooldown = 0

        # 원거리 공격(투사체) 관련
        self.shoot_timer = 0
        self.shoot_interval = 70  # 프레임마다 한 번씩 플레이어에게 투사체 발사

    def update(self, player, boss_bullets):
        # 플레이어를 향해 서서히 이동
        dx, dy = player.x - self.x, player.y - self.y
        dist = math.hypot(dx, dy)
        if dist > 1:
            ndx, ndy = dx / dist, dy / dist
            self.x += ndx * self.speed
            self.y += ndy * self.speed

        # 근접 충돌 데미지
        if self.hit_cooldown > 0:
            self.hit_cooldown -= 1
        if dist < self.radius + player.radius and self.hit_cooldown == 0:
            player.hp -= self.contact_damage
            self.hit_cooldown = 40

        # 원거리 공격: 일정 시간마다 플레이어를 향해 투사체 발사
        self.shoot_timer += 1
        if self.shoot_timer >= self.shoot_interval:
            self.shoot_timer = 0
            if dist > 0:
                bdx, bdy = dx / dist, dy / dist
            else:
                bdx, bdy = 1, 0
            boss_bullets.append(BossBullet(self.x, self.y, bdx, bdy))

    def draw(self, surface):
        pygame.draw.circle(surface, PURPLE, (int(self.x), int(self.y)), self.radius)
        pygame.draw.circle(surface, BLACK, (int(self.x), int(self.y)), self.radius, 4)

        # 화면 상단 중앙에 보스 전용 체력바 표시
        bar_w = 500
        bar_x = WIDTH // 2 - bar_w // 2
        bar_y = 20
        pygame.draw.rect(surface, GRAY, (bar_x, bar_y, bar_w, 25))
        pygame.draw.rect(surface, PURPLE, (bar_x, bar_y, bar_w * (self.hp / self.max_hp), 25))
        pygame.draw.rect(surface, WHITE, (bar_x, bar_y, bar_w, 25), 2)
        name_text = font.render(f"보스  {self.hp}/{self.max_hp}", True, WHITE)
        surface.blit(name_text, (WIDTH // 2 - name_text.get_width() // 2, bar_y + 30))


def draw_weapon_select(surface, options):
    """점수 달성 시 나타나는 무기 선택 화면 그리기"""
    overlay = pygame.Surface((WIDTH, HEIGHT))
    overlay.set_alpha(200)
    overlay.fill(BLACK)
    surface.blit(overlay, (0, 0))

    title = big_font.render("무기를 선택하세요!", True, WHITE)
    surface.blit(title, (WIDTH // 2 - title.get_width() // 2, 100))

    card_w, card_h = 180, 220
    gap = 30
    total_w = card_w * len(options) + gap * (len(options) - 1)
    start_x = WIDTH // 2 - total_w // 2
    y = 220

    for i, key in enumerate(options):
        weapon = WEAPONS[key]
        x = start_x + i * (card_w + gap)
        pygame.draw.rect(surface, (40, 40, 40), (x, y, card_w, card_h), border_radius=10)
        pygame.draw.rect(surface, weapon["color"], (x, y, card_w, card_h), 3, border_radius=10)

        num_text = big_font.render(str(i + 1), True, weapon["color"])
        surface.blit(num_text, (x + card_w // 2 - num_text.get_width() // 2, y + 15))

        name_text = font.render(weapon["name"], True, WHITE)
        surface.blit(name_text, (x + card_w // 2 - name_text.get_width() // 2, y + 65))

        desc_lines = [weapon["desc"][j:j + 10] for j in range(0, len(weapon["desc"]), 10)]
        for k, line in enumerate(desc_lines):
            line_text = small_font.render(line, True, GRAY)
            surface.blit(line_text, (x + card_w // 2 - line_text.get_width() // 2, y + 100 + k * 22))

        dmg_text = small_font.render(f"데미지 {weapon['damage']}", True, WHITE)
        surface.blit(dmg_text, (x + card_w // 2 - dmg_text.get_width() // 2, y + card_h - 30))

    hint = font.render("숫자 키(1~3)를 눌러 선택", True, YELLOW)
    surface.blit(hint, (WIDTH // 2 - hint.get_width() // 2, y + card_h + 30))


def explode(x, y, radius, monsters, damage):
    """폭발 효과 처리 함수 (바주카포 등) - 일반 몬스터 대상"""
    killed = 0
    for m in monsters[:]:
        dist = math.hypot(m.x - x, m.y - y)
        if dist < radius:
            m.hp -= damage
            if m.hp <= 0:
                monsters.remove(m)
                killed += 1
    return killed


def main():
    player = Player()
    monsters = []
    bullets = []
    explosions = []
    boss_bullets = []
    spawn_timer = 0
    spawn_interval = 90
    score = 0
    game_over = False

    weapon_select_active = False

    milestone_index = 0
    weapon_options = []

    # ---- 보스전 관련 상태 ----
    boss = None
    boss_active = False       # 지금 보스전이 진행 중인지
    boss_triggered = False    # 보스가 이미 한 번 등장했는지 (재등장 방지)
    victory = False           # 보스를 잡아서 승리했는지

    running = True
    while running:
        clock.tick(FPS)
        mouse_pos = pygame.mouse.get_pos()

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False

            if event.type == pygame.KEYDOWN:
                # 게임 오버 또는 승리 상태에서 R키를 누르면 재시작
                if event.key == pygame.K_r and (game_over or victory):
                    player = Player()
                    monsters = []
                    bullets = []
                    explosions = []
                    boss_bullets = []
                    spawn_timer = 0
                    spawn_interval = 90
                    score = 0
                    game_over = False
                    weapon_select_active = False
                    milestone_index = 0
                    boss = None
                    boss_active = False
                    boss_triggered = False
                    victory = False

                if weapon_select_active:
                    if event.key in (pygame.K_1, pygame.K_2, pygame.K_3):
                        idx = event.key - pygame.K_1
                        if idx < len(weapon_options):
                            player.weapon_key = weapon_options[idx]
                            weapon_select_active = False

            if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                if not game_over and not victory and not weapon_select_active:
                    player.try_shoot(mouse_pos[0], mouse_pos[1], bullets)

        # 게임 진행 중 로직
        if not game_over and not victory and not weapon_select_active:
            keys = pygame.key.get_pressed()
            player.move(keys)
            player.update()

            if pygame.mouse.get_pressed()[0]:
                player.try_shoot(mouse_pos[0], mouse_pos[1], bullets)

            # ---------------------------------------------------------------
            # [보스 등장 트리거] 점수가 BOSS_SCORE에 도달하고 아직 안 나왔으면
            # 기존 몬스터를 전부 없애고 보스 1마리만 소환 (1대1 구도)
            # ---------------------------------------------------------------
            if not boss_triggered and score >= BOSS_SCORE:
                boss_triggered = True
                boss_active = True
                monsters = []  # 일반 몬스터 전부 제거
                boss = Boss(WIDTH // 2, HEIGHT // 4)  # 화면 위쪽에서 등장

            if boss_active:
                # 보스전 중에는 일반 몬스터가 스폰되지 않음
                boss.update(player, boss_bullets)

                # 보스 투사체 업데이트 및 플레이어 충돌 체크
                for bb in boss_bullets[:]:
                    bb.update()
                    if bb.offscreen():
                        boss_bullets.remove(bb)
                        continue
                    dist = math.hypot(bb.x - player.x, bb.y - player.y)
                    if dist < bb.radius + player.radius:
                        player.hp -= bb.damage
                        boss_bullets.remove(bb)

                # 보스 처치 여부 체크
                if boss.hp <= 0:
                    boss_active = False
                    victory = True
            else:
                # ---- 보스전이 아닐 때만 일반 몬스터 스폰 ----
                spawn_timer += 1
                if spawn_timer >= spawn_interval:
                    spawn_timer = 0
                    monsters.append(Monster(hp_bonus=score))
                    if spawn_interval > 30:
                        spawn_interval -= 1

                for m in monsters:
                    m.update(player)

            # 총알 업데이트 및 충돌 체크 (일반 몬스터 + 보스 모두 대상)
            for b in bullets[:]:
                b.update()
                if b.offscreen():
                    bullets.remove(b)
                    continue

                hit = False

                # 보스전 중이면 보스와의 충돌부터 체크
                if boss_active and boss is not None:
                    dist_b = math.hypot(boss.x - b.x, boss.y - b.y)
                    if dist_b < boss.radius + b.radius:
                        if b.weapon["explosive"]:
                            explosions.append([b.x, b.y, 15])
                            boss.hp -= b.damage
                        else:
                            boss.hp -= b.damage
                        bullets.remove(b)
                        hit = True

                # 보스전이 아니면 일반 몬스터와 충돌 체크
                if not hit and not boss_active:
                    for m in monsters[:]:
                        dist = math.hypot(m.x - b.x, m.y - b.y)
                        if dist < m.radius + b.radius:
                            if b.weapon["explosive"]:
                                explosions.append([b.x, b.y, 15])
                                score += explode(b.x, b.y, b.weapon["explosion_radius"], monsters, b.damage)
                            else:
                                m.hp -= b.damage
                                if m.hp <= 0:
                                    monsters.remove(m)
                                    score += 1
                            if b in bullets:
                                bullets.remove(b)
                            break

            for e in explosions[:]:
                e[2] -= 1
                if e[2] <= 0:
                    explosions.remove(e)

            if player.hp <= 0:
                game_over = True

            if not boss_active and milestone_index < len(WEAPON_MILESTONES):
                if score >= WEAPON_MILESTONES[milestone_index]:
                    weapon_select_active = True
                    weapon_options = random.sample(list(WEAPONS.keys()), k=min(3, len(WEAPONS)))
                    milestone_index += 1

        # 화면 그리기
        screen.fill(BLACK)
        for m in monsters:
            m.draw(screen)
        if boss_active and boss is not None:
            boss.draw(screen)
        for bb in boss_bullets:
            bb.draw(screen)
        for b in bullets:
            b.draw(screen)
        for e in explosions:
            pygame.draw.circle(screen, ORANGE, (int(e[0]), int(e[1])), 80 - e[2] * 3, 3)

        player.draw(screen, mouse_pos)

        score_text = font.render(f"점수(처치): {score}", True, WHITE)
        screen.blit(score_text, (WIDTH - 180, 10))

        if boss_active:
            boss_notice = small_font.render("보스전 진행 중!", True, PURPLE)
            screen.blit(boss_notice, (WIDTH - 200, 40))
        elif not boss_triggered:
            if milestone_index < len(WEAPON_MILESTONES):
                next_text = small_font.render(f"다음 무기선택: {WEAPON_MILESTONES[milestone_index]}점", True, GRAY)
                screen.blit(next_text, (WIDTH - 200, 40))
            else:
                boss_hint = small_font.render(f"보스 등장: {BOSS_SCORE}점", True, PURPLE)
                screen.blit(boss_hint, (WIDTH - 200, 40))

        info_text = font.render("WASD 이동 / 마우스 클릭(or 드래그) 발사", True, WHITE)
        screen.blit(info_text, (10, HEIGHT - 30))

        if weapon_select_active:
            draw_weapon_select(screen, weapon_options)

        if game_over:
            over_text = big_font.render("게임 오버!", True, YELLOW)
            screen.blit(over_text, (WIDTH // 2 - over_text.get_width() // 2, HEIGHT // 2 - 30))
            restart_text = font.render("R키를 눌러 재시작", True, WHITE)
            screen.blit(restart_text, (WIDTH // 2 - restart_text.get_width() // 2, HEIGHT // 2 + 20))

        if victory:
            win_text = big_font.render("보스 처치! 승리했습니다!", True, GREEN)
            screen.blit(win_text, (WIDTH // 2 - win_text.get_width() // 2, HEIGHT // 2 - 30))
            restart_text = font.render("R키를 눌러 다시 시작", True, WHITE)
            screen.blit(restart_text, (WIDTH // 2 - restart_text.get_width() // 2, HEIGHT // 2 + 20))

        pygame.display.flip()

    pygame.quit()


if __name__ == "__main__":
    main()
